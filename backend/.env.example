PORT=5000
MONGODB_URI=mongodb://localhost:27017/eventpulse
NODE_ENV=development
DNS_SERVERS=8.8.8.8,8.8.4.4

# ── AI Recommendations (PRJ-8098-0018) ─────────────────────────────────────
# Set to your real OpenAI API key to enable live text-embedding-3-small calls.
# When absent or set to the placeholder the service falls back to the local
# deterministic semantic-hash vector generator (no external API needed).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Maximum OpenAI embedding calls per 60-second sliding window (rate limiter).
# Default: 60. Lower this during development to avoid accidental quota burn.
OPENAI_RATE_LIMIT_PER_MINUTE=60
